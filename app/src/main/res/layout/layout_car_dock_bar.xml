<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingDockContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <!-- Bouton / Poignée de déplacement tactile dédiée -->
    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="38dp"
        android:layout_height="60dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Déplacer la barre"
        android:scaleType="centerInside"
        android:src="@drawable/ic_drag_handle_horizontal" />

    <!-- 1. Bouton RETOUR -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="Retour"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back" />

    <!-- 2. Bouton ACCUEIL (HOME) -->
    <ImageButton
        android:id="@+id/btnHome"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="Accueil"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_home" />

    <!-- Séparateur fin -->
    <View
        android:id="@+id/dockSeparator"
        android:layout_width="2dp"
        android:layout_height="30dp"
        android:background="#2E3D52" />

    <!-- 3. Bouton SOURDINE (MUTE) -->
    <ImageButton
        android:id="@+id/btnMute"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="Sourdine"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mute" />

    <!-- 4. Bouton VOLUME MOINS -->
    <ImageButton
        android:id="@+id/btnVolDown"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="Volume Moins"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_volume_down" />

    <!-- 5. Bouton VOLUME PLUS -->
    <ImageButton
        android:id="@+id/btnVolUp"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="Volume Plus"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_volume_up" />

</LinearLayout>
