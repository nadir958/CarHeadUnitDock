<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- En-tête -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Car HeadUnit Dock"
            android:textColor="@color/car_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Barre de contrôle nocturne pour Autoradio Android (ZLink, CarPlay, GPS)"
            android:textColor="@color/car_text_secondary"
            android:textSize="13sp" />

        <!-- Carte 1 : Autorisations -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/car_surface_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/car_border_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Autorisations Système"
                    android:textColor="@color/car_accent_amber"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Permission Overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtStatusOverlay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="• Affichage par-dessus les applications : Non autorisé"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnGrantOverlay"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activer"
                        android:textColor="@color/car_accent_amber"
                        app:strokeColor="@color/car_accent_amber" />
                </LinearLayout>

                <!-- Permission Accessibility -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtStatusAccessibility"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="• Service Accessibilité (Retour/Home) : Désactivé"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnGrantAccessibility"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activer"
                        android:textColor="@color/car_accent_amber"
                        app:strokeColor="@color/car_accent_amber" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 2 : Style de la Barre (Dédiée Tesla vs Îlot Flottant) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/car_surface_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/car_border_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Style d'Affichage de la Barre"
                    android:textColor="@color/car_accent_amber"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choisissez l'expérience visuelle souhaitée dans votre véhicule :"
                    android:textColor="@color/car_text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgDockStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/radioStyleDedicated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Barre Dédiée Ancrée (Style Tesla / OEM) — Recommandé"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="Bandeau complet pleine largeur en bas (ou pleine hauteur à gauche). Boutons répartis aux extrémités et espace utile réservé pour ne rien masquer du GPS."
                        android:textColor="@color/car_text_muted"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/radioStyleFloating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Îlot Flottant Mobile"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="Capsule compacte déplaçable au doigt n'importe où sur l'écran avec poignée tactile et aimantation sur les bords."
                        android:textColor="@color/car_text_muted"
                        android:textSize="11sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 3 : Format de la Barre (Horizontal vs Vertical) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/car_surface_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/car_border_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Emplacement / Orientation de la Barre"
                    android:textColor="@color/car_accent_amber"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choisissez l'orientation de la barre selon votre cockpit :"
                    android:textColor="@color/car_text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgMenuOrientation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/radioOrientHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Horizontal (En bas de l'écran — Style Tesla)"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioOrientVertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Vertical (Bord gauche — Style CarPlay Côté Conducteur)"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 4 : Taille Globale de la Barre -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/car_surface_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/car_border_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Taille Globale de la Barre"
                    android:textColor="@color/car_accent_amber"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Mise à l'échelle proportionnelle (capsule, boutons squircle, poignée de déplacement et marges) :"
                    android:textColor="@color/car_text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgButtonSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/radioSizeCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Compact (Boutons 42 dp / Barre 56 dp) — Discret"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioSizeMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Standard (Boutons 52 dp / Barre 68 dp) — Équilibré"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioSizeLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Grand (Boutons 60 dp / Barre 82 dp) — Recommandé Voiture"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioSizeXLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Très Grand (Boutons 72 dp / Barre 96 dp) — Maxi Lisibilité Conduite"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 4 : Aimantation Intelligente sur les Bords (Snap to Edge) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/car_surface_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/car_border_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5. Aimantation Intelligente (Mode Flottant)"
                            android:textColor="@color/car_accent_amber"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="S'aimante automatiquement au bord le plus proche (gauche/droite en vertical, bas/haut en horizontal) dès que vous relâchez le doigt."
                            android:textColor="@color/car_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSnapToEdge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:checked="true" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 5 : Choix des 2 Options (Option A vs Option B) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/car_surface_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/car_border_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6. Configuration de l'Écran (Options d'Affichage)"
                    android:textColor="@color/car_accent_amber"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choisissez comment la barre s'intègre avec vos applications GPS :"
                    android:textColor="@color/car_text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgIntegrationMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <!-- OPTION A -->
                    <RadioButton
                        android:id="@+id/radioOptionA"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Option A : Superposition directe (Plein écran natif)"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="La barre s'affiche en îlot flottant déplaçable sans modifier la résolution."
                        android:textColor="@color/car_text_muted"
                        android:textSize="11sp" />

                    <!-- OPTION B -->
                    <RadioButton
                        android:id="@+id/radioOptionB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Option B : Redimensionnement d'écran (Display Inset - Zéro masquage)"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="L'espace sous l'écran est réservé : Waze, Maps et ZLink s'arrêtent pile au-dessus de la barre sans rien cacher."
                        android:textColor="@color/car_text_muted"
                        android:textSize="11sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Commandes de démarrage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartDock"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@color/car_accent_amber"
                android:text="Activer la Barre"
                android:textColor="@color/car_bg_black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopDock"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:text="Masquer"
                android:textColor="@color/car_text_primary"
                app:strokeColor="@color/car_border_dark" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
