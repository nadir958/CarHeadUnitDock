<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- En-tête -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Car HeadUnit Dock"
            android:textColor="@color/car_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Barre de contrôle nocturne pour Autoradio Android (ZLink, CarPlay, GPS)"
            android:textColor="@color/car_text_secondary"
            android:textSize="13sp" />

        <!-- Carte 1 : Autorisations -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/car_surface_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/car_border_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Autorisations Système"
                    android:textColor="@color/car_accent_amber"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Permission Overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtStatusOverlay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="• Affichage par-dessus les applications : Non autorisé"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnGrantOverlay"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activer"
                        android:textColor="@color/car_accent_amber"
                        app:strokeColor="@color/car_accent_amber" />
                </LinearLayout>

                <!-- Permission Accessibility -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtStatusAccessibility"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="• Service Accessibilité (Retour/Home) : Désactivé"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnGrantAccessibility"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Activer"
                        android:textColor="@color/car_accent_amber"
                        app:strokeColor="@color/car_accent_amber" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 2 : Format du Menu (Horizontal vs Vertical) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/car_surface_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/car_border_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Format du Menu Flottant"
                    android:textColor="@color/car_accent_amber"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choisissez l'orientation de la barre flottante selon votre cockpit :"
                    android:textColor="@color/car_text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgMenuOrientation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/radioOrientHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Horizontal (En ligne — Recommandé en bas ou haut)"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioOrientVertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Vertical (En colonne — Côté conducteur gauche ou droit)"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 3 : Taille des Boutons -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/car_surface_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/car_border_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Taille des Boutons Tactiles"
                    android:textColor="@color/car_accent_amber"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ajustez la taille selon la distance et la diagonale de votre écran :"
                    android:textColor="@color/car_text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgButtonSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/radioSizeCompact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Compact (44 dp) — Discret"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioSizeMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Standard (56 dp) — Équilibré"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioSizeLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Grand (68 dp) — Recommandé Tablette Voiture"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/radioSizeXLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Très Grand (80 dp) — Gros boutons haute visibilité"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 4 : Choix des 2 Options (Option A vs Option B) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/car_surface_dark"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/car_border_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Configuration de l'Écran (Options d'Affichage)"
                    android:textColor="@color/car_accent_amber"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choisissez comment la barre s'intègre avec vos applications GPS :"
                    android:textColor="@color/car_text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgIntegrationMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <!-- OPTION A -->
                    <RadioButton
                        android:id="@+id/radioOptionA"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Option A : Superposition directe (Plein écran natif)"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="La barre s'affiche en îlot flottant déplaçable sans modifier la résolution."
                        android:textColor="@color/car_text_muted"
                        android:textSize="11sp" />

                    <!-- OPTION B -->
                    <RadioButton
                        android:id="@+id/radioOptionB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:buttonTint="@color/car_accent_amber"
                        android:text="Option B : Redimensionnement d'écran (Display Inset - Zéro masquage)"
                        android:textColor="@color/car_text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="L'espace sous l'écran est réservé : Waze, Maps et ZLink s'arrêtent pile au-dessus de la barre sans rien cacher."
                        android:textColor="@color/car_text_muted"
                        android:textSize="11sp" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Commandes de démarrage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartDock"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@color/car_accent_amber"
                android:text="Activer la Barre"
                android:textColor="@color/car_bg_black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopDock"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:text="Masquer"
                android:textColor="@color/car_text_primary"
                app:strokeColor="@color/car_border_dark" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
